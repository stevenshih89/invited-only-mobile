{
  "name": "InvitedOnly",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ios:dev": "react-native run-ios --scheme 'development'",
    "dev": "ENV_FILE=.env.development npx react-native start --reset-cache",
    "staging": "ENV_FILE=.env.staging npx react-native start --reset-cache",
    "prod": "ENV_FILE=.env.production npx react-native start --reset-cache",
    "ios:dev-release": "react-native run-ios --configuration Release --scheme 'development'",
    "ios:prod": "react-native run-ios --scheme 'production'",
    "ios:prod-release": "react-native run-ios --configuration Release --scheme 'production'",
    "ios:staging": "react-native run-ios --scheme 'staging'",
    "ios:staging-release": "react-native run-ios --configuration Release --scheme 'staging'",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "iphone14Pro": "react-native run-ios --simulator=\"iPhone 14 Pro\"",
    "iphone15Pro": "react-native run-ios --simulator=\"iPhone 15 Pro\"",
    "start-reset": "react-native start -- --reset-cache",
    "pod:install": "cd ios && pod install --repo-update && cd ..",
    "pod:reinstall": "cd ios && rm -rf Pods && rm -rf Podfile.lock && pod install --repo-update && cd ..",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build": "npm run lint && tsc"
  },
